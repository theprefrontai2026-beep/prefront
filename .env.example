# Copy to .env and fill in an LLM key. Used by skill-builder (extract-rules)
# and semantic-layer (semantic mapper). Provider defaults to openai (the UI no
# longer selects it) — set OPENAI_API_KEY, or override LLM_PROVIDER + its key.
LLM_PROVIDER=openai

OPENAI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=

# Runtime datasource for semantic-mcp-server. Defaults to the bundled SecureBank
# Postgres (in this compose); override to point the engine at another database.
DATABASE_URL=postgresql://securebank:securebank@securebank-db:5432/securebank

# --- eval-engine: Family 1/3 artifacts ----------------------------------------
# Unset by default (Hard Rule 9: Family 2 runs with zero artifacts; Family 1/3
# stay idle and the Overview's policy-coverage counters read 0). To evaluate a
# demo's policy rules + intent catalog, point these at the copies its seed job
# puts in the shared `artifacts` volume (loanpro-demo/docker-compose.yml). Put
# them HERE, not inline on the command line — any `docker compose up` that
# recreates eval-engine (e.g. `--build ui`, which recreates its dependencies)
# re-reads .env and silently drops inline values.
# EVAL_RULE_PACK_PATH=/artifacts/loanpro-demo/rule_pack.yaml
# EVAL_INTENT_CATALOG_PATH=/artifacts/loanpro-demo/intent_catalog.yaml
# Compliance overlay (Layer B, compliance_design.md) - the demo's is seeded
# beside the two files above. Framework packs are bundled with eval-engine.
# EVAL_COMPLIANCE_OVERLAY_PATH=/artifacts/loanpro-demo/compliance_overlay.yaml
# Retention as ClickHouse TTLs (days; 0/unset = none). Set BOTH together.
# OOB_RETENTION_DAYS=90
# EVAL_RETENTION_DAYS=90
# decision_trace rows kept per demo by api-server (0 = never prune).
# DECISION_TRACE_CAP=100

# --- Tracing (Arize Phoenix) -------------------------------------------------
# The bundled `phoenix` service collects OTLP/HTTP spans and serves the trace UI
# on http://localhost:6006. Defaults below are what compose already uses, so
# nothing needs setting for tracing to work — these are the knobs:
#   PREFRONT_TRACING=0            turn tracing off everywhere
#   PREFRONT_ENGINE_TRACING=1     also trace Prefront's OWN services. Off (0) by
#                                 default so nothing inline is traced; turn on to
#                                 debug the engine itself.
#   PREFRONT_TRACE_EXCLUDE_SPANS= span-name prefixes never recorded, together with
#                                 everything they call. Compose sets
#                                 "governed agent" on the demo orchestrators.
#   PHOENIX_COLLECTOR_ENDPOINT=   point at your own OTLP/HTTP collector instead
#   PHOENIX_PROJECT_NAME=         group traces under a different Phoenix project
# PREFRONT_TRACING=1
# PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006
# PHOENIX_PROJECT_NAME=prefront
#
# If you ALREADY run Phoenix locally it owns 6006/4317 and the bundled service
# cannot publish them. Either move the bundled one:
#   PHOENIX_UI_PORT=6007
#   PHOENIX_GRPC_PORT=4318
# or drop it and export to the one you have:
#   PHOENIX_COLLECTOR_ENDPOINT=http://host.docker.internal:6006

# The OpenAI instrumentor records prompts and completions — which, for the demo
# agents, include governed query results. Uncomment to keep them out of Phoenix.
# (Prefront's own spans never carry rows, only the decision.)
# OPENINFERENCE_HIDE_INPUTS=true
# OPENINFERENCE_HIDE_OUTPUTS=true

# --- OOB observability (ClickHouse) -------------------------------------------
# oob-ingest tails Phoenix into ClickHouse and also receives a direct OTLP
# fan-out copy of every span (PREFRONT_TRACE_FANOUT). The UI's Observability
# tab reads /oob/*. Defaults work out of the box; knobs:
#   PREFRONT_TRACE_FANOUT=        set empty to disable the direct tap (Phoenix pull still runs).
#                                 Compose sets it on the APP AGENTS only — Prefront's own
#                                 services are never tapped (OOB = out-of-band).
#   OOB_EXCLUDE_ATTR_PREFIXES=prefront.        inline spans dropped on the pull path,
#   OOB_EXCLUDE_SPAN_NAMES=governed agent,govern   together with their whole subtree
#   OOB_EXCLUDE_SERVICES=
#   OOB_PHOENIX_URL=              where oob-ingest pulls spans from (default http://phoenix:6006)
#   OOB_PHOENIX_PROJECTS=         comma-separated projects to tail (default: all)
#   OOB_POLL_SECONDS=5            Phoenix poll interval
#   OOB_MODEL_PRICES='{"gpt-4o-mini":{"input":0.15,"output":0.6}}'  $/1M tokens for cost estimates
#   CLICKHOUSE_HTTP_PORT=8123 / CLICKHOUSE_TCP_PORT=9000              host ports
#   CLICKHOUSE_PASSWORD=          leave empty for the bundled local instance
