# Verdict — the standalone LoanPro scenario runner ("business decision
# evaluator"), built inside the same pnpm workspace as the main UI but served
# as its own static site. It needs exactly one nginx proxy rule (see
# verdict-nginx.conf): SessionDetail's oob-ingest calls are relative paths
# (/oob/sessions/:id), inherited unchanged from the main app's Observability.tsx
# which relies on same-origin proxying. Everything else — the orchestrator's
# /api/* — is a plain cross-origin fetch the browser handles directly, since
# that service already sends permissive CORS headers.
FROM node:24-slim AS build
WORKDIR /workspace

RUN npm install -g pnpm@10

COPY . .
RUN pnpm install --frozen-lockfile

# vite.config.ts requires PORT and BASE_PATH at build time. PORT is irrelevant
# for a static build; BASE_PATH=/ serves the app at root.
RUN PORT=5180 BASE_PATH=/ pnpm --filter @workspace/verdict run build

# ---- runtime: static files behind nginx -----------------------------------
FROM nginx:alpine
COPY --from=build /workspace/artifacts/verdict/dist /usr/share/nginx/html
COPY verdict-nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
